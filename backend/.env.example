# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitoring_durian
DB_USER=postgres
DB_PASSWORD=change-this-password

# Authentication: replace with a long random secret before deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
TOKEN_TTL_SECONDS=28800

# Key used only by the local Python simulator.
SIMULATOR_API_KEY=replace-with-a-different-random-simulator-key

# Sidebar shows the simulator as active while a delivery was received within this window.
SIMULATOR_STATUS_TIMEOUT_SECONDS=8
