# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitoring_durian
DB_USER=postgres
DB_PASSWORD=change-this-password

# Authentication: replace with a long random secret before deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
TOKEN_TTL_SECONDS=28800

# Key used only by the local Python simulator.
SIMULATOR_API_KEY=replace-with-a-different-random-simulator-key

# Recent-delivery indicator threshold used by the sidebar.
SIMULATOR_STATUS_TIMEOUT_SECONDS=8

# Mark an entire session failed only after this many seconds without data.
# This is longer than the simulator's request timeout and retry window.
SIMULATOR_SESSION_TIMEOUT_SECONDS=45

# Delay between CSV records; default is 2 seconds.
SIMULATOR_INTERVAL_SECONDS=2

# Optional simulator settings.
# MONITORING_API_URL=http://127.0.0.1:8000/monitoring/
# SIMULATOR_START_DATE=2026-01-01
